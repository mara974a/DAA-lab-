#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
    int dist[MAX], visited[MAX], parent[MAX];
    int i, j, min, minNode;

    for (i = 1; i <= n; i++) {
        dist[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
    }
    dist[startnode] = 0;

    for (i = 1; i <= n; i++) {
        min = INFINITY;
        minNode = -1;
        for (j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < min) {
                min = dist[j];
                minNode = j;
            }
		}
	// write your code here
        if (minNode == -1) break;
        visited[minNode] = 1;

        for (j = 1; j <= n; j++) {
            if (G[minNode][j] > 0 && !visited[j] && dist[minNode] + G[minNode][j] < dist[j]) {
                dist[j] = dist[minNode] + G[minNode][j];
                parent[j] = minNode;
            }
        }
    }
printf("Node\tDistance\tPath\n");
    for (i = 1; i <= n; i++) {
        if (i == startnode) continue;
        if (dist[i] == INFINITY) {
            printf("%4d\t%8s\tNO PATH\n", i, "INF");
        } else {
            printf("%4d\t%8d\t", i, dist[i]);
            int path[MAX], len = 0, cur = i;
            while (cur != -1) {
                path[len++] = cur;
                if (cur == startnode) break;
                cur = parent[cur];
			}
            for (j = 0; j < len; j++) {
                printf("%d", path[j]);
                if (j < len - 1) printf("<-");
            }
            printf("\n");
        }
    }


}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 

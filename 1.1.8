#include <stdio.h>

int main() {
    int m, n;
    scanf("%d %d", &m, &n);

    int A[100][100];
    for (int i = 0; i < m; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &A[i][j]);

    int rowsB, colsB;
    scanf("%d %d", &rowsB, &colsB);

    if (n != rowsB) {
        printf("Invalid input\n");
        return 0;
    }

    int B[100][100];
    for (int i = 0; i < rowsB; i++)
        for (int j = 0; j < colsB; j++)
            scanf("%d", &B[i][j]);

    int C[100][100] = {{0}};
    for (int i = 0; i < m; i++)
        for (int j = 0; j < colsB; j++)
            for (int k = 0; k < n; k++)
                C[i][j] += A[i][k] * B[k][j];

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < colsB; j++)
            printf("%d ", C[i][j]);
        printf("\n");
    }

    return 0;
}   

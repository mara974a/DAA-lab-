#include <stdio.h>
#include <limits.h>

int main() {
    int V, E;
    scanf("%d", &V);
    scanf("%d", &E);

    int u[E], v[E], w[E];
    for (int i = 0; i < E; i++)
        scanf("%d %d %d", &u[i], &v[i], &w[i]);

    int src;
    scanf("%d", &src);

    int dist[V + 1], parent[V + 1];
    for (int i = 1; i <= V; i++) {
        dist[i] = INT_MAX;
        parent[i] = -1;
    }
    dist[src] = 0;

   
    for (int i = 1; i < V; i++) {
        for (int j = 0; j < E; j++) {
            if (dist[u[j]] != INT_MAX &&
                (long long)dist[u[j]] + w[j] < dist[v[j]]) {
                dist[v[j]] = dist[u[j]] + w[j];
                parent[v[j]] = u[j];
            }
        }
    }

    
    for (int j = 0; j < E; j++) {
        if (dist[u[j]] != INT_MAX &&
            (long long)dist[u[j]] + w[j] < dist[v[j]]) {
            printf("Negative cycle detected\n");
            return 0;
        }
    }

    
    for (int i = 1; i <= V; i++) {
        if (i == src) continue;
        if (dist[i] == INT_MAX) {
            printf("%d INF None\n", i);
        } else {
            
            int path[V + 1], len = 0, cur = i;
            while (cur != -1) {
                path[len++] = cur;
                if (cur == src) break;
                cur = parent[cur];
            }
            printf("%d %d ", i, dist[i]);
            for (int k = len - 1; k >= 0; k--) {
                printf("%d", path[k]);
                if (k > 0) printf("->");
            }
            printf("\n");
        }
    }
    return 0;
}   
